    <sys:String x:Key="LOCOneMenuWelcomeBugTitle">Un bug ou une idée ?</sys:String>
    <sys:String x:Key="LOCOneMenuWelcomeBugText">Les rapports de bugs et les suggestions sont toujours les bienvenus. Rejoignez le Discord de Playnite et parlez-m'en là-bas.</sys:String>
