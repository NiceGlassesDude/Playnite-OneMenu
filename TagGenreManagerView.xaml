<UserControl x:Class="OneMenu.TagGenreManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="TagsRadio" Content="Tags" GroupName="TagGenreMode"
                         Checked="Mode_Changed" Margin="0,0,20,0" VerticalAlignment="Center" />
            <RadioButton x:Name="GenresRadio" Content="Genres" GroupName="TagGenreMode"
                         Checked="Mode_Changed" VerticalAlignment="Center" />
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,10" Padding="4"
                 TextChanged="SearchBox_TextChanged" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Tags &amp; Genres" FontWeight="Bold" Margin="0,0,0,2" />
                <TextBlock Text="Double-click a tag or genre to edit or delete it globally" Opacity="0.6" FontSize="11" Margin="0,0,0,4" />
                <ListBox x:Name="MasterList" Height="480" DisplayMemberPath="DisplayText"
             SelectionChanged="MasterList_SelectionChanged"
             MouseDoubleClick="MasterList_MouseDoubleClick" />
            </StackPanel>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="#33FFFFFF" Margin="0,20,0,0" />

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="SelectedHeaderText" FontWeight="Bold" Margin="0,0,0,2" />
                <TextBlock Text="Double-click a game to remove selected tag or genre from it" Opacity="0.6" FontSize="11" Margin="0,0,0,4" />
                <ListBox x:Name="GamesList" Height="480" DisplayMemberPath="Name"
             MouseDoubleClick="GamesList_MouseDoubleClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
