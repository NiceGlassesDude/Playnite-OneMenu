<Window x:Class="OneMenu.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource LOCOneMenuWelcomeWindowTitle}" Height="620" Width="860"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource NormalBrush}"
        Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="28" Background="#22FFFFFF">
                            <TextBlock x:Name="Glyph"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#4DFFFFFF" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource NormalBrushDark}">
            <TextBlock Text="{DynamicResource LOCOneMenuWelcomeWindowTitle}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="✕" Width="40" Click="Close_Click" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#33FFFFFF" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="92" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource ArrowButtonStyle}" Content="&#xE76B;"
                    ToolTip="{DynamicResource LOCOneMenuWelcomeBack}" Click="BackButton_Click" />

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Margin="0,24,0,16">
                <StackPanel x:Name="PageContent" VerticalAlignment="Center" MaxWidth="600">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="PageTranslate" />
                    </StackPanel.RenderTransform>

                    <Image x:Name="PageImage" Width="96" Height="96" Stretch="Uniform" HorizontalAlignment="Center"
                           Margin="0,0,0,18" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />

                    <Border x:Name="PageGlyphCircle" Width="84" Height="84" CornerRadius="42" Background="{DynamicResource GlyphBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock x:Name="PageGlyph" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="Bold" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock x:Name="PageIntro" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                               Opacity="0.85" LineHeight="21" Margin="0,0,0,20" />

                    <ItemsControl x:Name="StepsList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF" CornerRadius="6" Padding="14,11" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                Background="{DynamicResource GlyphBrush}" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                                   LineHeight="19" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="BugReportPanel" Background="#14FFFFFF" CornerRadius="6" Padding="18,16" Margin="0,4,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource LOCOneMenuWelcomeBugTitle}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource LOCOneMenuWelcomeBugText}" TextWrapping="Wrap" TextAlignment="Center"
                                       Opacity="0.85" FontSize="13" LineHeight="19" Margin="0,0,0,12" />
                            <Button Content="{DynamicResource LOCOneMenuWelcomeDiscordButton}" Padding="18,8" HorizontalAlignment="Center"
                                    ToolTip="https://discord.gg/BrtABqe" Click="DiscordButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource ArrowButtonStyle}" Content="&#xE76C;"
                    ToolTip="{DynamicResource LOCOneMenuWelcomeNext}" Click="NextButton_Click" />
        </Grid>

        <Border Grid.Row="3" Background="#33FFFFFF" />

        <Grid Grid.Row="4" Margin="16,12,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SkipButton" Grid.Column="0" Content="{DynamicResource LOCOneMenuWelcomeSkip}" Padding="14,7"
                    HorizontalAlignment="Left" Click="Close_Click" />

            <StackPanel x:Name="DotsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="PageCounterText" Opacity="0.6" VerticalAlignment="Center" />
                <Button x:Name="FinishButton" Content="{DynamicResource LOCOneMenuWelcomeFinish}" Padding="18,7" Margin="12,0,0,0"
                        Click="Close_Click" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
