<UserControl x:Class="OneMenu.OneMenuSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OneMenu"
             MinWidth="780" MinHeight="520">
    <UserControl.Resources>
        <local:NullToBoolConverter x:Key="NullToBoolConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToDimOpacityConverter x:Key="BoolToDimOpacityConverter" />
        <local:PathToImageConverter x:Key="PathToImageConverter" />
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />

        <HierarchicalDataTemplate x:Key="EditorNodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2" Opacity="{Binding IsHidden, Converter={StaticResource BoolToDimOpacityConverter}}">
                <TextBlock Text="&#xE90C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                           ToolTip="{DynamicResource LOCOneMenuSideButton}"
                           Visibility="{Binding ShowInSidebar, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{Binding SidebarPosition, StringFormat={}{0}.}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"
                           Visibility="{Binding ShowInSidebar, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical" Width="150" Margin="0,0,10,0">
                    <Button Content="{DynamicResource LOCOneMenuAddCategory}" Margin="0,0,0,4" Command="{Binding AddRootNodeCommand}"
                            ToolTip="{DynamicResource LOCOneMenuAddCategoryTooltip}" HorizontalContentAlignment="Center" />
                    <Button Content="{DynamicResource LOCOneMenuAddSubItem}" Margin="0,0,0,4" Command="{Binding AddChildNodeCommand}"
                            ToolTip="{DynamicResource LOCOneMenuAddSubItemTooltip}" HorizontalContentAlignment="Center" />
                    <Button Content="{DynamicResource LOCOneMenuRemove}" Margin="0,0,0,14" Command="{Binding RemoveSelectedNodeCommand}"
                            HorizontalContentAlignment="Center" />
                    <Button Content="{DynamicResource LOCOneMenuMoveUp}" Margin="0,0,0,4" Command="{Binding MoveSelectedUpCommand}"
                            HorizontalContentAlignment="Center" />
                    <Button Content="{DynamicResource LOCOneMenuMoveDown}" Margin="0,0,0,14" Command="{Binding MoveSelectedDownCommand}"
                            HorizontalContentAlignment="Center" />
                    <Button Content="{DynamicResource LOCOneMenuSetIcon}" Margin="0,0,0,14" Command="{Binding ToggleMainIconEditorCommand}"
                            HorizontalContentAlignment="Center" />
                    <CheckBox IsChecked="{Binding TagSearchEnabled}"
                              ToolTip="{DynamicResource LOCOneMenuTagBrowserEnableTooltip}">
                        <TextBlock Text="{DynamicResource LOCOneMenuTagBrowser}" TextWrapping="Wrap" />
                    </CheckBox>
                    <Button Content="{DynamicResource LOCOneMenuAdvSettingsButton}" Margin="0,10,0,0" Command="{Binding OpenAdvancedSettingsCommand}"
                            HorizontalContentAlignment="Center" />
                    <Button Content="{DynamicResource LOCOneMenuWelcomeShowGuide}" Margin="0,4,0,0" Command="{Binding ShowWelcomeGuideCommand}"
                            ToolTip="{DynamicResource LOCOneMenuWelcomeShowGuideTooltip}" HorizontalContentAlignment="Center" />
                </StackPanel>

                <Border DockPanel.Dock="Left" Width="1" Background="#33FFFFFF" Margin="0,0,10,0" />

                <TreeView x:Name="NodesTreeView"
                          ItemsSource="{Binding RootNodes}"
                          ItemTemplate="{StaticResource EditorNodeTemplate}"
                          SelectedItemChanged="NodesTreeView_SelectedItemChanged" />
            </DockPanel>

            <Border Grid.Column="1" Width="1" Background="#33FFFFFF" />

            <StackPanel Grid.Column="2" IsEnabled="{Binding SelectedNode, Converter={StaticResource NullToBoolConverter}}">
                <TextBlock Text="{DynamicResource LOCOneMenuSelectedItem}" FontWeight="Bold" Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource LOCOneMenuTitle}" />
                <TextBox Text="{Binding SelectedNode.Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                <TextBlock Text="{DynamicResource LOCOneMenuDisplayMode}" />
                <ComboBox ItemsSource="{Binding DisplayModeOptions}"
                          DisplayMemberPath="DisplayText"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedNode.DisplayMode}"
                          IsEnabled="{Binding SelectedNode.ShowInSidebar, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                          Margin="0,2,0,6" />

                <CheckBox IsChecked="{Binding SelectedNode.ShowInSidebar}">
                    <TextBlock Text="{DynamicResource LOCOneMenuSideButton}" TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                            Visibility="{Binding SelectedNode.ShowInSidebar, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding SideButtonPositionText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Padding="10,5" Margin="0,0,6,0"
                            Command="{Binding MoveSideButtonUpCommand}"
                            ToolTip="{DynamicResource LOCOneMenuSideButtonMoveUp}" />
                    <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Padding="10,5"
                            Command="{Binding MoveSideButtonDownCommand}"
                            ToolTip="{DynamicResource LOCOneMenuSideButtonMoveDown}" />
                </StackPanel>
                <TextBlock Text="{DynamicResource LOCOneMenuSideButtonHint}" TextWrapping="Wrap" Opacity="0.7" FontSize="11"
                           Margin="0,4,0,10" />

                <TextBlock Text="{DynamicResource LOCOneMenuIcon}" />
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="28" Height="28" Margin="0,0,6,0" Background="#22FFFFFF" CornerRadius="3">
                        <Image Source="{Binding SelectedNode.IconPath, Converter={StaticResource PathToImageConverter}, ConverterParameter=56}"
                               Width="22" Height="22" Stretch="Uniform" />
                    </Border>
                    <TextBox Grid.Column="1" Text="{Binding SelectedNode.IconPath}" IsReadOnly="True" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="{DynamicResource LOCOneMenuBrowse}" Command="{Binding BrowseIconCommand}" Margin="0,0,6,0"
                            ToolTip="{DynamicResource LOCOneMenuBrowseIconTooltip}" />
                    <Button Grid.Column="3" Content="{DynamicResource LOCOneMenuIconLibraryButton}" Command="{Binding PickIconFromLibraryCommand}" Margin="0,0,6,0"
                            ToolTip="{DynamicResource LOCOneMenuIconLibraryTooltip}" />
                    <Button Grid.Column="4" Content="{DynamicResource LOCOneMenuClear}" Command="{Binding ClearIconCommand}" />
                </Grid>

                <TextBlock Text="{DynamicResource LOCOneMenuWhenClicked}"
                           TextWrapping="Wrap"
                           Visibility="{Binding SelectedNode.IsCategory, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                <ComboBox ItemsSource="{Binding ActionTypeOptions}"
                          DisplayMemberPath="DisplayText"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedNode.ActionType}"
                          Margin="0,2,0,10"
                          Visibility="{Binding SelectedNode.IsCategory, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                <TextBlock Text="{DynamicResource LOCOneMenuFilterPresetLabel}"
                           TextWrapping="Wrap"
                           Visibility="{Binding SelectedNode.IsFilterPresetAction, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ComboBox ItemsSource="{Binding AvailableFilterPresets}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedNode.FilterPresetId}"
                          Margin="0,2,0,10"
                          Visibility="{Binding SelectedNode.IsFilterPresetAction, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="{DynamicResource LOCOneMenuOpenPathLabel}"
                           TextWrapping="Wrap"
                           Visibility="{Binding SelectedNode.IsOpenPathAction, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Grid Margin="0,2,0,10"
                      Visibility="{Binding SelectedNode.IsOpenPathAction, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedNode.TargetPath}" IsReadOnly="True" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="{DynamicResource LOCOneMenuBrowseFile}" Command="{Binding BrowseTargetFileCommand}" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="{DynamicResource LOCOneMenuBrowseFolder}" Command="{Binding BrowseTargetFolderCommand}" />
                </Grid>

                <TextBlock Text="{DynamicResource LOCOneMenuCategoryHint}"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Visibility="{Binding SelectedNode.IsCategory, Converter={StaticResource BoolToVisibilityConverter}}" />

                <CheckBox IsChecked="{Binding SelectedNode.IsHidden}" Margin="0,16,0,0">
                    <TextBlock Text="{DynamicResource LOCOneMenuHideButton}" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Text="{DynamicResource LOCOneMenuHideCategoryHint}"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Margin="0,4,0,0"
                           Visibility="{Binding SelectedNode.IsCategory, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="10" BorderThickness="1" BorderBrush="#33FFFFFF"
                Visibility="{Binding ShowMainIconEditor, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding MainIconPreviewPath, Converter={StaticResource PathToImageConverter}, ConverterParameter=96}"
                       Width="48" Height="48" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource LOCOneMenuMainIcon}" FontWeight="Bold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource LOCOneMenuBrowse}" Margin="0,0,6,0" Command="{Binding BrowseMainIconCommand}" />
                        <Button Content="{DynamicResource LOCOneMenuIconLibraryButton}" Margin="0,0,6,0" Command="{Binding PickMainIconFromLibraryCommand}" />
                        <Button Content="{DynamicResource LOCOneMenuResetDefault}" Command="{Binding ResetMainIconCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
