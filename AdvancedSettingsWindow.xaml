<Window x:Class="OneMenu.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OneMenu"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Advanced Settings" Height="790" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NormalBrush}"
        Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#4DFFFFFF" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource NormalBrushDark}">
            <TextBlock Text="Advanced Settings" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="✕" Width="40" Click="Close_Click" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#33FFFFFF" />

        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="CategoryList" Grid.Column="0" SelectionChanged="CategoryList_SelectionChanged"
                     Background="{DynamicResource NormalBrushDark}" BorderThickness="0" Padding="4">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource GlyphBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Tag Browser" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Theme" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="T&amp;G Manager" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Import &amp; Export" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <Border Grid.Column="1" Width="1" Background="#33FFFFFF" />

            <Border Grid.Column="2" BorderBrush="{DynamicResource NormalBrushDark}" BorderThickness="1"
                    CornerRadius="4" Padding="20">
                <Grid>
                    <StackPanel x:Name="TagBrowserPanel">
                        <TextBlock Text="Window Transparency" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                        <Slider x:Name="TransparencySlider" Minimum="0" Maximum="70"
                                Value="{Binding TagBrowserTransparencyPercent}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding TagBrowserTransparencyPercent, StringFormat={}{0:0}% transparent}"
                                   Opacity="0.7" Margin="0,0,0,14" />

                        <Border Width="240" Height="64" CornerRadius="4" Margin="0,0,0,26"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource GlyphBrush}"
                                Opacity="{Binding TagBrowserOpacity}">
                            <TextBlock Text="Preview" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="White" FontWeight="Bold" />
                        </Border>

                        <TextBlock Text="Window Size" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding TagBrowserSizeOptions}" DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Value" SelectedValue="{Binding TagBrowserSize}"
                                  HorizontalAlignment="Left" MinWidth="220" />
                    </StackPanel>

                    <StackPanel x:Name="ThemePanel" Visibility="Collapsed">
                        <TextBlock Text="Theme" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />
                        <CheckBox x:Name="FollowPlayniteThemeCheckBox" IsChecked="{Binding FollowPlayniteTheme}"
                                  Click="FollowPlayniteThemeCheckBox_Click">
                            <TextBlock Text="Use custom theme instead of OneMenu's default" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,0"
                                   Text="Advanced Settings uses OneMenu's own color scheme by default. Check this to use your own theme." />
                    </StackPanel>

                    <StackPanel x:Name="TagsGenresPanel" Visibility="Collapsed">
                        <TextBlock Text="Tags and Genre Manager" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />
                        <local:TagGenreManagerView />
                    </StackPanel>

                    <StackPanel x:Name="ImportExportPanel" Visibility="Collapsed">
                        <TextBlock Text="Import &amp; Export" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />
                        <TextBlock Text="What to include" Opacity="0.8" Margin="0,0,0,8" />

                        <CheckBox x:Name="ExportTagsCheckBox" IsChecked="True" Margin="0,0,0,8">
                            <TextBlock Text="Tags" />
                        </CheckBox>
                        <CheckBox x:Name="ExportGenresCheckBox" IsChecked="True" Margin="0,0,0,8">
                            <TextBlock Text="Genres" />
                        </CheckBox>
                        <CheckBox x:Name="ExportConfigCheckBox" IsChecked="True" Margin="0,0,0,8">
                            <TextBlock Text="Flyout Config (Main and Sub- Categories)" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="ExportIconsCheckBox" IsChecked="True" Margin="0,0,0,16">
                            <TextBlock Text="Icons" />
                        </CheckBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export..." Padding="14,7" Margin="0,0,10,0" Click="Export_Click" />
                            <Button Content="Import..." Padding="14,7" Click="Import_Click" />
                        </StackPanel>

                        <TextBlock x:Name="ImportExportStatusText" TextWrapping="Wrap" Opacity="0.8" Margin="0,16,0,0" />

                        <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,20,0,0"
                                   Text="Multiple exports bundle into a single zip. Tag and genre imports add missing names without linking them to games. Config imports overwrite your menu and apply upon saving" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#33FFFFFF" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,16">
            <Button Content="Close" Padding="16,8" Click="SaveAndClose_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
